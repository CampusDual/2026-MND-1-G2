ALTER TABLE PUBLIC.REQUEST_CATEGORIES ALTER COLUMN CATEGORY_ID RESTART WITH 12
CREATE MEMORY TABLE PUBLIC.REQUEST_SUBCATEGORIES(SUBCATEGORY_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CATEGORY_ID BIGINT NOT NULL,NAME VARCHAR(160) NOT NULL,DESCRIPTION VARCHAR(255) NOT NULL,ICON VARCHAR(80) NOT NULL,ACTIVE BOOLEAN NOT NULL,CONSTRAINT FK_REQUEST_SUBCATEGORIES_CATEGORY FOREIGN KEY(CATEGORY_ID) REFERENCES PUBLIC.REQUEST_CATEGORIES(CATEGORY_ID))
ALTER TABLE PUBLIC.REQUEST_SUBCATEGORIES ALTER COLUMN SUBCATEGORY_ID RESTART WITH 49

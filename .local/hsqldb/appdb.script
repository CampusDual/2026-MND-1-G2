CREATE MEMORY TABLE PUBLIC.CABINS(CABIN_ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CABIN_NUMBER INTEGER NOT NULL,UNIQUE(CABIN_NUMBER))
